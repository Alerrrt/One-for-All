# API Configuration
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Redis Connection
REDIS_URL=redis://redis:6379

# File Storage
UPLOAD_DIR=/data/inputs
OUTPUT_DIR=/data/outputs
TEMP_DIR=/data/temp
MAX_FILE_SIZE_MB=5000

# Database (PostgreSQL)
DB_NAME=conversion_engine
DB_USER=postgres

# SECURITY: NEVER use default passwords in production!
# Generate a strong random password: openssl rand -base64 32
DB_PASSWORD=your_secure_password_here

DB_HOST=postgres

# Processing
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_SECONDS=3600
CLEANUP_TEMP_FILES=true

# Security - CRITICAL: These MUST be set properly in production!
# 
# API_KEY: Generate with: openssl rand -hex 32
# This is REQUIRED and will block all requests if not set properly
# DO NOT use default values like 'your_api_key_here' in production
API_KEY=your_api_key_here

# CORS_ORIGIN: Comma-separated list of allowed origins
# Set to your frontend domain(s) - NEVER use '*' in production
# Examples:
#   Single domain: https://yourdomain.com
#   Multiple domains: https://app.yourdomain.com,https://www.yourdomain.com
# Leave empty or set to 'false' to disable CORS (most secure)
CORS_ORIGIN=http://localhost:3000

# Worker Configuration
WORKER_CONCURRENCY=2

